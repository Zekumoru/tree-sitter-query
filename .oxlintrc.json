{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "ignorePatterns": ["node_modules/**", ".build/**", "dist/**", ".vscode-test/**"],
  "overrides": [
    {
      "files": ["tests/**/*.test.ts"],
      "plugins": ["vitest"]
    }
  ]
}
